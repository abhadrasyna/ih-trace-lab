{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 scripts/dev/hooks/autopilot_checkpoint.py --init",
        "powershell": "python scripts/dev/hooks/autopilot_checkpoint.py --init",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 scripts/dev/hooks/autopilot_checkpoint.py --check",
        "powershell": "python scripts/dev/hooks/autopilot_checkpoint.py --check",
        "timeoutSec": 10
      }
    ]
  }
}
